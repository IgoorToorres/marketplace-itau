{
  "info": {
    "_postman_id": "7b7ef266-c149-4b7c-a9e0-7db978d81142",
    "name": "Marketplace - API de clientes",
    "description": "Testes manuais da API Spring Data REST. Execute as requisições na ordem para criar e reutilizar o customerId.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "customerId",
      "value": "",
      "type": "string"
    },
    {
      "key": "customerEmail",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/actuator/health",
        "description": "Confirma que a aplicação e suas dependências estão disponíveis."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Aplicação saudável', function () {",
              "  pm.expect(pm.response.json().status).to.eql('UP');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Raiz HAL",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/hal+json"
          }
        ],
        "url": "{{baseUrl}}/",
        "description": "Lista os recursos publicados pelo Spring Data REST."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Recurso customers publicado', function () {",
              "  pm.expect(pm.response.json()._links.customers.href).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Criar cliente",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('customerEmail', `maria.${Date.now()}@example.com`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.test('Location contém o cliente criado', function () {",
              "  const location = pm.response.headers.get('Location');",
              "  pm.expect(location).to.be.a('string').and.not.empty;",
              "  const customerId = location.split('/').filter(Boolean).pop();",
              "  pm.expect(customerId).to.match(/^[0-9a-f-]{36}$/i);",
              "  pm.collectionVariables.set('customerId', customerId);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/hal+json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Maria\",\n  \"lastName\": \"Silva\",\n  \"email\": \"{{customerEmail}}\",\n  \"address\": {\n    \"street\": \"Rua das Flores, 10\",\n    \"postalCode\": \"01001-000\",\n    \"city\": \"Sao Paulo\",\n    \"state\": \"SP\"\n  }\n}"
        },
        "url": "{{baseUrl}}/customers",
        "description": "Cria um cliente com endereço, gera e-mail único e salva o UUID retornado em customerId."
      }
    },
    {
      "name": "4. Listar clientes",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/hal+json"
          }
        ],
        "url": "{{baseUrl}}/customers",
        "description": "Lista clientes usando a projeção excerpt."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Coleção HAL presente', function () {",
              "  pm.expect(pm.response.json()._embedded.customers).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Consultar cliente por ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/hal+json"
          }
        ],
        "url": "{{baseUrl}}/customers/{{customerId}}",
        "description": "Consulta o cliente criado anteriormente."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Cliente consultado é o criado', function () {",
              "  pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get('customerEmail'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Buscar por prefixo do nome",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/hal+json"
          }
        ],
        "url": "{{baseUrl}}/customers/search/findByFirstNameStartingWithIgnoreCase?firstName=MAR",
        "description": "Busca clientes cujo primeiro nome começa com MAR, ignorando caixa."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Busca retorna uma coleção HAL', function () {",
              "  pm.expect(pm.response.json()._embedded.customers).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Atualizar sobrenome",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"lastName\": \"Oliveira\"\n}"
        },
        "url": "{{baseUrl}}/customers/{{customerId}}",
        "description": "Atualiza parcialmente o cliente criado."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 204', function () {",
              "  pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Confirmar exclusão HTTP bloqueada",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/customers/{{customerId}}",
        "description": "Confirma que o repositório não publica a operação DELETE."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 405', function () {",
              "  pm.response.to.have.status(405);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
